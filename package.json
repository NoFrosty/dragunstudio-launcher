{
  "name": "warplauncher",
  "version": "0.1.0",
  "private": true,
  "description": "Evorine multi application launcher",
  "author": "Evorine",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "electron:build": "vue-cli-service electron:build",
    "electron:generate-icons": "electron-icon-builder --input=./public/images/icon.png --output=build --flatten",
    "electron:serve": "vue-cli-service electron:serve",
    "i18n:report": "vue-cli-service i18n:report --src './src/**/*.?(js|vue)' --locales './src/locales/**/*.json'",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps"
  },
  "main": "background.js",
  "dependencies": {
    "auto-launch": "^5.0.5",
    "awilix": "^4.3.1",
    "axios": "^0.21.1",
    "bsdiff-node": "^2.2.4",
    "buefy": "^0.9.4",
    "core-js": "^2.6.11",
    "countries-list": "^2.6.1",
    "crypto-js": "^4.0.0",
    "electron-updater": "^4.3.8",
    "electron-window-state": "^5.0.3",
    "fs-extra": "^9.1.0",
    "humanize": "^0.0.9",
    "marked": "^2.0.0",
    "memory-streams": "^0.1.3",
    "moment": "^2.29.1",
    "request": "^2.88.2",
    "request-progress": "^3.0.0",
    "rimraf": "^3.0.2",
    "string-format": "^2.0.0",
    "ts-bus": "^2.3.1",
    "unzipper": "^0.10.11",
    "vee-validate": "^3.4.5",
    "vue": "^2.6.12",
    "vue-async-computed": "^3.9.0",
    "vue-class-component": "^7.2.6",
    "vue-i18n": "^8.22.4",
    "vue-property-decorator": "^9.1.2",
    "vue-router": "^3.5.1",
    "vuex": "^3.6.2",
    "vuex-electron": "^1.0.3",
    "web-request": "^1.0.7",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^14.14.28",
    "@types/webpack": "^4.41.18",
    "@vue/cli-plugin-babel": "^3.12.1",
    "@vue/cli-plugin-eslint": "^3.12.1",
    "@vue/cli-plugin-typescript": "^3.12.1",
    "@vue/cli-service": "^3.12.1",
    "@vue/eslint-config-typescript": "^4.0.0",
    "babel-eslint": "^10.1.0",
    "electron": "^12.0.1",
    "electron-builder": "^22.10.5",
    "electron-icon-builder": "^2.0.1",
    "eslint": "^5.16.0",
    "eslint-plugin-vue": "^5.0.0",
    "node-sass": "^5.0.0",
    "sass": "^1.32.7",
    "sass-loader": "^10.1.1",
    "typescript": "^4.1.5",
    "vue-cli-plugin-electron-builder": "^1.4.6",
    "vue-cli-plugin-i18n": "^1.0.1",
    "vue-template-compiler": "^2.6.12"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended",
      "@vue/typescript"
    ],
    "rules": {},
    "parserOptions": {
      "parser": "@typescript-eslint/parser"
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "keywords": [
    "launcher",
    "game",
    "evorine",
    "evolauncher"
  ],
  "license": "© 2019-2020 Evorine All Rights Reserved",
  "productName": "Warp Launcher"
}
